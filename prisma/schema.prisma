generator client {
  provider = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x", "debian-openssl-1.1.x", "linux-musl", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  entidades Entidade[]

  @@map("users")
}

model Entidade {
  id          String         @id @default(uuid())
  titulo      String
  descricao   String?
  status      EntidadeStatus @default(RASCUNHO)
  vagasUsadas Int            @default(0)
  userId      String
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  user        User           @relation(fields: [userId], references: [id])

  @@map("entidades")
}

model PoolControl {
  id          Int @id @default(1)
  totalVagas  Int @default(100)
  vagasUsadas Int @default(0)

  @@map("pool_control")
}

enum EntidadeStatus {
  RASCUNHO
  PROCESSANDO
  CONCLUIDO
}
